# WordPress — irestorationpros.com
WP_LEADCAPTURE_URL=https://irestorationpros.com
WP_LEADCAPTURE_USERNAME=your-wp-username
WP_LEADCAPTURE_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# WordPress — findrestorationpros.com (leave blank until Phase 2)
WP_AUTHORITY_URL=https://findrestorationpros.com
WP_AUTHORITY_USERNAME=
WP_AUTHORITY_PASSWORD=

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
OPENAI_API_KEY=sk-...

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Make.com (replaces Zapier)
MAKE_WEBHOOK_URL=https://hook.us1.make.com/...
MAKE_WEBHOOK_SECRET=choose-any-random-string-32-chars

# CallRail
CALLRAIL_API_KEY=
CALLRAIL_ACCOUNT_ID=
CALLRAIL_TRACKING_NUMBER=(855) 999-0000

# Google APIs (set up after launch)
GOOGLE_SERVICE_ACCOUNT_PATH=./config/google-service-account.json
GA4_PROPERTY_ID_LEADCAPTURE=
GA4_PROPERTY_ID_AUTHORITY=

# Security settings
RATE_LIMIT_PER_HOUR=5
MAX_FIELD_LENGTH=500

# Key rotation date
KEY_ROTATION_DATE=2026-03-29
