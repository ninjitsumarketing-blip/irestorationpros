# FRP staging — test-only credentials. Copy to `.env.test` and fill in.
# `.env.test` is gitignored. Never commit real secrets.
# Provisioned in Task 0.0 of docs/superpowers/plans/2026-04-17-frp-launch-plan.md

# Staging WordPress — provisioned in Task 0.0
FRP_STAGING_URL=https://staging.findrestorationpros.com
FRP_STAGING_USERNAME=test-runner
FRP_STAGING_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Non-admin user for auth-gating tests (subscriber role, no manage_options)
FRP_STAGING_SUBSCRIBER_USERNAME=test-subscriber
FRP_STAGING_SUBSCRIBER_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# MailHog / mail capture (captures wp_mail output on staging)
# UI served by ops — confirm the final path with ops after provisioning.
FRP_MAILHOG_URL=https://staging.findrestorationpros.com/mailhog

# Cloudflare Turnstile — always-pass TEST keys (NOT production)
# These are public, published, intentionally-insecure test keys.
# Docs: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_TEST_SITEKEY=1x00000000000000000000AA
TURNSTILE_TEST_SECRET=1x0000000000000000000000000000000AA

# Stripe — TEST MODE credentials (sk_test_... / pk_test_... / whsec_...)
# Get from: https://dashboard.stripe.com/test/apikeys
# Webhook secret from: https://dashboard.stripe.com/test/webhooks → endpoint → signing secret
STRIPE_TEST_SECRET_KEY=sk_test_...
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_...
STRIPE_TEST_WEBHOOK_SECRET=whsec_...
